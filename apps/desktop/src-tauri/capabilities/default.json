{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "allow-list",
    "allow-search",
    "allow-get",
    "allow-bookmark-favicon",
    "allow-add",
    "allow-update",
    "allow-delete",
    "allow-retry",
    "allow-tag-groups",
    "allow-create-tag-group",
    "allow-rename-tag-group",
    "allow-delete-tag-group",
    "allow-set-tag-group",
    "allow-get-settings",
    "allow-save-settings",
    "allow-save-extraction-settings",
    "allow-test-connection",
    "allow-reextract",
    "allow-extract-with-ai",
    "allow-has-extraction-model",
    "allow-reindex",
    "allow-process-unsummarized",
    "allow-stats",
    "allow-api-info",
    "allow-regenerate-api-token",
    "allow-profiles",
    "allow-create-profile",
    "allow-rename-profile",
    "allow-delete-profile",
    "allow-switch-profile",
    "allow-move-bookmark",
    "allow-extracting",
    "allow-notifications",
    "allow-push-notification",
    "allow-mark-notifications-read",
    "allow-dismiss-notification",
    "allow-clear-notifications",
    "allow-import-preview",
    "allow-import-confirm",
    "allow-import-cancel",
    "allow-export-bookmarks",
    "allow-extract-imported",
    "allow-retry-failed",
    "allow-app-status",
    "allow-locale-info",
    "allow-set-locale",
    "allow-update-info",
    "allow-check-update",
    "allow-install-update",
    "allow-set-update-auto",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
