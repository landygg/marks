{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "marks",
  "identifier": "dev.landygg.marks",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "width": 1100,
        "height": 720,
        "minWidth": 1032,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; form-action 'none'; base-uri 'none'; frame-src 'none'; object-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5NTc0NEU0Q0IyOUJDMzkKUldRNXZDbkw1RVJYQ1FRU2JwZ3RxaTExQVlpTjZsem8xUTdzczBPanIveU81OEpwb0RTN0xiU0sK",
      "endpoints": [
        "https://github.com/landygg/marks/releases/latest/download/latest-{{target}}-{{arch}}.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": { "minimumSystemVersion": "15.0" },
    "resources": {
      "infoplist/es.lproj/InfoPlist.strings": "es.lproj/InfoPlist.strings",
      "infoplist/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
